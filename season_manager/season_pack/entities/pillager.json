{
  "format_version": "1.26.50",
  "minecraft:entity": {
    "description": {
      "identifier": "minecraft:pillager",
      "is_summonable": true,
      "is_spawnable": true,
      "spawn_category": "monster"
    },
    "component_groups": {
      "season:elite_guard_pillager": {
        "minecraft:health": {
          "max": 40,
          "value": 40
        },
        "minecraft:behavior.ranged_attack": {
          "attack_interval": {
            "min": 1.0,
            "max": 3.0
          },
          "attack_range": {
            "min": 0.0,
            "max": 32.0
          },
          "priority": 0
        },
        "minecraft:shooter": {
          "def": "minecraft:arrow",
          "sound": "crossbow.shoot"
        },
        "minecraft:equipment": {
          "table": "loot_tables/entities/season_elite_guard_pillager_equipment.json"
        },
        "minecraft:type_family": {
          "family": [
            "pillager",
            "illager",
            "monster",
            "mob",
            "season_elite"
          ]
        },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "on_damage": {
                "filters": {
                  "test": "is_family",
                  "subject": "other",
                  "value": "season_elite"
                }
              },
              "deals_damage": "no"
            },
            {
              "cause": "fall",
              "deals_damage": false
            }
          ]
        },
        "minecraft:behavior.hurt_by_target": {
          "priority": 1,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  {
                    "operator": "not",
                    "test": "is_family",
                    "subject": "other",
                    "value": "breeze"
                  },
                  {
                    "operator": "not",
                    "test": "is_family",
                    "subject": "other",
                    "value": "season_elite"
                  }
                ]
              }
            }
          ]
        },
        "minecraft:follow_range": {
          "value": 48,
          "max": 48
        },
        "minecraft:despawn": {
          "filters": {
            "test": "is_family",
            "subject": "self",
            "value": "season_never_despawns"
          }
        }
      },
      "season:elite_guard_pillager_targeting": {
        "minecraft:behavior.nearest_attackable_target": {
          "reselect_targets": true,
          "must_see": true,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "max_dist": 48
            }
          ],
          "priority": 2
        }
      }
    },
    "events": {
      "season:become_elite_guard_pillager": {
        "add": {
          "component_groups": [
            "season:elite_guard_pillager",
            "season:elite_guard_pillager_targeting"
          ]
        }
      },
      "season:elite_guard_pillager_retarget": {
        "remove": {
          "component_groups": [
            "season:elite_guard_pillager_targeting"
          ]
        },
        "add": {
          "component_groups": [
            "season:elite_guard_pillager_targeting"
          ]
        }
      }
    }
  }
}
